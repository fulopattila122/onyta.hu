---
import Base from '../layouts/Base.astro';

const title = 'Rólunk - ÖNYTA';
const description = 'Az Önismeret a Nyitott Társadalomért Alapítvány célja az egyéni és közösségi önismeret, a kritikai gondolkodás és a társadalmi párbeszéd erősítése.';
---

<Base title={title} description={description}>
  <div class="relative space-y-12 py-4">
    <!-- Header Section with Uppercase Eyebrow and Small Caps -->
    <section class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase bg-blue-50 text-blue-700 border border-blue-100">
        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
        Küldetés és értékrend
      </div>

      <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
        Rólunk (Küldetésünk)
      </h1>
    </section>

    <!-- Main Content Container with Subtle Noise/Grain Texture and Color Structure -->
    <article class="relative grain-texture rounded-3xl bg-gradient-to-br from-white via-blue-50/20 to-slate-50/50 border border-gray-200/80 p-6 sm:p-10 lg:p-12 shadow-sm overflow-hidden">
      <!-- Decorative color accent elements -->
      <div class="absolute -top-16 -right-16 w-56 h-56 bg-blue-100/40 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="absolute -bottom-16 -left-16 w-56 h-56 bg-indigo-100/30 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="relative max-w-3xl mx-auto space-y-10">
        <!-- Opening Paragraph with Drop Cap & Small Caps highlight -->
        <section class="space-y-4">
          <p class="drop-cap text-lg sm:text-xl text-gray-700 leading-relaxed text-justify sm:text-left">
            <span class="small-caps font-semibold text-gray-900">Az Önismeret a Nyitott Társadalomért Alapítvány</span> célja, hogy elősegítse az egyéni
            és közösségi szintű önismeretet, mint a bizalomra épülő társadalom alapját.
          </p>
        </section>

        <!-- Pull Quote: Set off in a narrower measure than the body -->
        <section class="py-2">
          <blockquote class="max-w-2xl mx-auto my-4 p-6 sm:p-8 rounded-2xl bg-white/90 border-l-4 border-blue-600 shadow-sm border border-gray-100 relative">
            <div class="absolute top-3 right-4 text-4xl text-blue-200/80 font-serif select-none pointer-events-none" aria-hidden="true">
              &rdquo;
            </div>
            <p class="text-xl sm:text-2xl font-serif italic text-gray-800 leading-relaxed">
              „Hiszünk abban, hogy a nyitott, demokratikus közösségek csak akkor működhetnek
              fenntarthatóan, ha tagjaik képesek reflektálni saját működésükre, félelmeikre és
              előítéleteikre.”
            </p>
          </blockquote>
        </section>

        <!-- Closing Statement with Structural Coloration -->
        <section class="p-6 sm:p-7 rounded-2xl bg-blue-50/60 border border-blue-100 space-y-4">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span>
            <span class="text-xs font-bold uppercase tracking-widest text-blue-800">
              Működési pilléreink
            </span>
          </div>
          <p class="text-lg sm:text-xl font-medium text-gray-900 leading-relaxed">
            Az alapítvány munkája az <span class="text-blue-700 font-semibold underline decoration-blue-300 underline-offset-4">önismeret</span>, a <span class="text-indigo-700 font-semibold underline decoration-indigo-300 underline-offset-4">kritikai gondolkodás</span> és a <span class="text-teal-700 font-semibold underline decoration-teal-300 underline-offset-4">társadalmi párbeszéd</span> összekapcsolására épül.
          </p>
        </section>
      </div>
    </article>
  </div>
</Base>

<style>
  /* Subtle Noise/Grain Background Texture */
  .grain-texture {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.035'/%3E%3C/svg%3E");
  }

  /* Small Caps */
  .small-caps {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.04em;
  }

  /* Drop Cap */
  .drop-cap::first-letter {
    font-size: 3.75rem;
    line-height: 0.8;
    float: left;
    font-weight: 800;
    margin-right: 0.75rem;
    margin-top: 0.1rem;
    color: #2563eb; /* Tailwind blue-600 */
    font-family: Georgia, Cambria, 'Times New Roman', Times, serif;
  }
</style>
