---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/celjaink', label: 'Céljaink' },
  { href: '/programjaink', label: 'Programjaink' },
  { href: '/rolunk', label: 'Rólunk' },
  { href: '/tamogatoink', label: 'Támogatóink' },
];
---

<nav aria-label="Main Navigation">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-3 text-xl font-bold tracking-tight text-gray-900">
          <img src="/logo.png" alt="onyta.hu" width="384" height="384" class="h-10 w-10 object-contain" />
          <span>ÖNYTA</span>
        </a>
      </div>

      <!-- Desktop navigation -->
      <div class="hidden md:flex space-x-6">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'text-sm font-medium transition-colors hover:text-blue-600',
                currentPath === item.href
                  ? 'text-blue-600 font-semibold'
                  : 'text-gray-600',
              ]}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <!-- Mobile hamburger menu -->
      <div class="flex items-center md:hidden">
        <details class="relative group">
          <summary
            class="flex items-center justify-center p-2 rounded-lg text-gray-700 hover:text-blue-600 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500 cursor-pointer list-none [&::-webkit-details-marker]:hidden"
            aria-label="Menü megnyitása"
          >
            <!-- Hamburger icon (shown when closed) -->
            <svg
              class="h-6 w-6 block group-open:hidden"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <!-- Close icon (shown when open) -->
            <svg
              class="h-6 w-6 hidden group-open:block"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </summary>

          <!-- Mobile dropdown menu -->
          <div
            class="absolute right-0 top-full mt-2 w-56 origin-top-right rounded-2xl bg-white p-2 shadow-xl ring-1 ring-black/5 border border-gray-100 z-50 focus:outline-none"
          >
            <div class="flex flex-col space-y-1">
              {
                navItems.map((item) => (
                  <a
                    href={item.href}
                    class:list={[
                      'px-3.5 py-2.5 rounded-xl text-base font-medium transition-colors hover:bg-gray-50 hover:text-blue-600',
                      currentPath === item.href
                        ? 'bg-blue-50 text-blue-600 font-semibold'
                        : 'text-gray-700',
                    ]}
                    aria-current={currentPath === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                ))
              }
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</nav>
